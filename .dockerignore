# ─────────────────────────────────────────────────────────────
#  .dockerignore — files excluded from the Docker build context
#  Keeps the image small and prevents secrets from leaking in.
# ─────────────────────────────────────────────────────────────

# Secrets — NEVER bake the real .env into the image
.env
*.env

# Python caches & bytecode
__pycache__/
*.py[cod]
*.pyo
.Python

# Virtual environments
.venv/
venv/
env/

# Test artefacts
tests/
.pytest_cache/
.coverage
htmlcov/

# IDE / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Docs (not needed at runtime)
README.md
*.md

# Docker files themselves (no need to copy inside the image)
Dockerfile
docker-compose.yml
compose.yaml
.dockerignore
