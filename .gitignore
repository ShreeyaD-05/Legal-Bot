# Environment secrets — NEVER commit these
.env
*.env
.env.local
.env.production

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode & cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
Thumbs.db

# Docker
*.log

# Pre-downloaded pip wheels (used for offline Docker builds only)
wheels/
