# ─────────────────────────────────────────────────────────────
#  LegalBot — Environment Configuration Template
#  Copy this file to .env and fill in your actual values.
#  NEVER commit your real .env file to version control.
# ─────────────────────────────────────────────────────────────

# Groq API Key — get yours free at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_actual_groq_api_key_here

# Groq model to use (openai/gpt-oss-120b is recommended for free tier)
GROQ_MODEL=openai/gpt-oss-120b

# FastAPI server host and port
HOST=127.0.0.1
PORT=8000

# Timeout in seconds for agent requests
REQUEST_TIMEOUT=60
